{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "dev/**", "scripts/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn",
        "useTemplate": "error",
        "useExponentiationOperator": "warn",
        "noDescendingSpecificity": "error"
      },
      "complexity": {
        "useLiteralKeys": "error",
        "noImportantStyles": "error"
      },
      "correctness": {
        "noInvalidDirectionInLinearGradient": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noFocusedTests": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["dev/**"],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false
          },
          "style": {
            "useTemplate": "warn"
          },
          "complexity": {
            "useLiteralKeys": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    }
  ]
}
