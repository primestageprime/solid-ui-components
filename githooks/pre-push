#!/bin/sh
# SUI gate — gates PUSHES only.
#
# Runs `scripts/gate.mjs --pre-push`, and NOTHING else: CI's lint and typecheck
# commands, only the AFFECTED tests (scripts/affected-tests.mjs), catalog
# freshness (blocks) and usage-manifest freshness (warns, never blocks), so a
# push takes minutes, not a full-suite run.
#
# This hook holds NO check of its own. Every check is a stage in
# scripts/gate-stages.mjs — the one list `npm run gate`, this hook and the CI
# guard test (scripts/gate-stages.test.ts) all read. Until 2026-11-12 the
# catalog and usage-manifest checks were written out here and were not gate
# stages, so a green `npm run gate` could still be refused at push (thorcasting
# #4472). To add a push check, add a stage there with `prePush: true`; a
# command added to this file fails that test. The full suite, coverage, health ratchet and
# builds are the PR gate (CI / `npm run gate`) — pre-push and CI differ in
# BREADTH only, never in the commands they run.
# See scripts/gate.mjs's header for the rationale, for the machine-wide lock,
# and for `healthStepPrePush` (the ratchet's auto-baseline mode, no longer run
# on push; still reachable via `gate --pre-push --only health`). Commits are
# never gated (Peter ruling 2026-07-15).
#
# Versioned in githooks/; wired via `git config core.hooksPath githooks`,
# which the npm "prepare" script sets automatically on install.
echo "pre-push: SUI gate (scripts/gate.mjs --pre-push — lint, typecheck, AFFECTED tests, catalog freshness, usage-manifest warning; the full suite, health and builds run at the PR gate)…"
if ! node scripts/gate.mjs --pre-push; then
  {
    echo ""
    echo "══════════════════════════════════════════════════════════════"
    echo " ✗ PUSH BLOCKED — see the failed step above"
    echo ""
    echo " Push tier = lint + typecheck + only the tests that reach your diff"
    echo " + catalog freshness (stale catalog.json: npm run catalog, commit it)."
    echo " The full suite, coverage, health ratchet and builds run at the PR"
    echo " gate (CI), so a green push is not a green PR."
    echo ""
    echo "   see which tests a push runs:  node scripts/affected-tests.mjs"
    echo "   run just the failing step:    npm run gate -- --only <step>"
    echo "   run what CI runs (full):      npm run gate"
    echo "   ...without the slow builds:   npm run gate -- --fast"
    echo ""
    echo " Health ratchet no longer runs on push. If CI's health job fails,"
    echo " run 'npm run health' (or 'npm run gate -- --only health') locally;"
    echo " after an improvement, 'npm run health -- --update-baseline'."
    echo "══════════════════════════════════════════════════════════════"
  } >&2
  exit 1
fi
