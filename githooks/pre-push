#!/bin/sh
# SUI gate — gates PUSHES only.
#
# Runs `scripts/gate.mjs --pre-push`: the exact step list CI runs
# (.github/workflows/ci.yml), in CI's order, with CI's flags — so pre-push
# and CI cannot drift into asking different questions. See scripts/gate.mjs's
# header for the full rationale, for how `build`/`bundle-budget` stay out of
# this checkout's live `node_modules/.vite` (so a running `vite --port 6006`
# dev server is never disturbed), and for exactly what `--pre-push` changes
# on the health step (only its response to an unrecorded ratchet
# IMPROVEMENT — it auto-commits the tightened baseline instead of costing a
# manual `--update-baseline` round-trip on every gain, then still blocks
# THIS push, because a commit made inside this hook cannot join the push
# that triggered it — verified, not assumed; see the comment on
# `healthStepPrePush` in scripts/gate.mjs). A real regression still blocks
# exactly as before. Commits are otherwise never gated (Peter ruling
# 2026-07-15) — the one exception is that single, deliberate, self-documenting
# baseline commit, which exists to make forgetting `--update-baseline`
# impossible rather than to gate anything.
#
# Versioned in githooks/; wired via `git config core.hooksPath githooks`,
# which the npm "prepare" script sets automatically on install.
echo "pre-push: SUI gate (scripts/gate.mjs --pre-push — same checks as CI)…"
if ! node scripts/gate.mjs --pre-push; then
  {
    echo ""
    echo "══════════════════════════════════════════════════════════════"
    echo " ✗ PUSH BLOCKED — see the failed step above"
    echo ""
    echo " scripts/gate.mjs runs every CI job's exact commands, in CI's"
    echo " order, and stops at the first failure — same gate either way."
    echo ""
    echo "   run everything gate runs:    npm run gate"
    echo "   run just the failing step:   npm run gate -- --only <step>"
    echo "   skip the (slow) build step:  npm run gate -- --fast"
    echo ""
    echo " If the failed step was health: a REGRESSION still blocks here"
    echo " exactly like above (see the ✗ REGRESSED lines). An unrecorded"
    echo " IMPROVEMENT does not — gate already committed the tightened"
    echo " baseline locally (scripts/health-baseline.json); the ONLY reason"
    echo " this push is still blocked is that the hook's own commit cannot"
    echo " join the push that triggered it. Just run 'git push' again."
    echo "══════════════════════════════════════════════════════════════"
  } >&2
  exit 1
fi

# Production usage manifest freshness — does docs/usage-manifest.json still
# match what the SUI-consuming production repos import (scripts/usage-manifest.mjs)?
#
# WARNS, never blocks (2026-08-05, dside sui 12565). It blocked until it had
# refused four consecutive unrelated pushes, all of which went through with
# --no-verify; a gate that trains you to bypass it is worse than no gate.
#
# Two reasons it cannot be a gate in this shape:
#
#   1. It compares against consumer WORKING COPIES on whoever's machine is
#      pushing — unpinned, possibly mid-feature, possibly on another branch.
#      The last block was five line numbers moving in thorcasting-ui because
#      somebody added three lines above an import. Nothing about SUI changed.
#      And the printed remedy ("regenerate and commit") would have committed a
#      snapshot of another developer's working tree into this repo.
#
#   2. It is silent on the change it exists to catch. --check compares the
#      committed manifest against a fresh consumer scan; deleting a SUI export
#      changes NEITHER side, because the manifest records consumers' imports
#      and not SUI's exports. Delete something thorcasting-ui imports and this
#      check passes. It blocked the noise and permitted the harm.
#
# The gate worth having asks a different question — "does any repo that tracks
# main unpinned import a name this push no longer exports?" — and needs SUI's
# own export surface, which the tool does not currently compute. Filed on
# dside sui 12565. Until then the manifest is a REPORT: regenerate it when you
# want a survey, which is exactly when you are deciding whether an export is
# safe to remove. Do not trust the committed copy without regenerating.
echo "pre-push: SUI usage manifest freshness (scripts/usage-manifest.mjs --check)…"
if ! node scripts/usage-manifest.mjs --check; then
  {
    echo ""
    echo "──────────────────────────────────────────────────────────────"
    echo " ⚠ docs/usage-manifest.json is stale — NOT blocking this push"
    echo ""
    echo " Consumer imports drifted since the manifest was generated"
    echo " (differences listed above). Usually this is another repo's"
    echo " working copy moving, and has nothing to do with your change."
    echo ""
    echo " Regenerate when you actually need the survey — above all"
    echo " before deleting or renaming an export:"
    echo ""
    echo "   npm run usage-manifest"
    echo ""
    echo " This check does NOT verify that your push keeps consumers"
    echo " compiling. See dside sui 12565."
    echo "──────────────────────────────────────────────────────────────"
  } >&2
fi
