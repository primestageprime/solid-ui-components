{
  "name": "@primestageprime/solid-ui-components",
  "version": "0.159.0",
  "description": "SolidJS UI Components Library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primestageprime/solid-ui-components.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/server/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./themes/_baseline.css": {
      "source": "./src/themes/_baseline.css",
      "default": "./dist/themes/_baseline.css"
    },
    "./themes/default.css": {
      "source": "./src/themes/default.css",
      "default": "./dist/themes/default.css"
    },
    "./themes/hud.css": {
      "source": "./src/themes/hud.css",
      "default": "./dist/themes/hud.css"
    },
    "./themes/bronze.css": {
      "source": "./src/themes/bronze.css",
      "default": "./dist/themes/bronze.css"
    },
    "./themes/bronze-dark.css": {
      "source": "./src/themes/bronze-dark.css",
      "default": "./dist/themes/bronze-dark.css"
    },
    "./themes/stax.css": {
      "source": "./src/themes/stax.css",
      "default": "./dist/themes/stax.css"
    },
    "./themes/colorblind.css": {
      "source": "./src/themes/colorblind.css",
      "default": "./dist/themes/colorblind.css"
    },
    "./themes/colorblind-modifier.css": {
      "source": "./src/themes/colorblind-modifier.css",
      "default": "./dist/themes/colorblind-modifier.css"
    },
    "./themes/*": {
      "source": "./src/themes/*",
      "default": "./dist/themes/*"
    },
    "./styles.css": {
      "source": "./src/themes/default.css",
      "default": "./dist/themes/default.css"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "_sideEffects": "PAIRED with output.preserveModules in vite.config.ts — see docs/adr/0005-per-module-dist-and-sideeffects.md. Neither setting does anything alone; together they let a consumer's bundler delete unused SUI modules AND the heavyweight deps they import (katex, d3-dag). Removing either silently re-adds ~318 KB to every consumer bundle. Guarded by scripts/build-config.test.ts.",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --port 6006",
    "build": "npm run build:client && npm run build:server",
    "build:client": "SUI_BUILD_TARGET=client vite build --mode production",
    "build:server": "SUI_BUILD_TARGET=server vite build --mode production --ssr src/index.ts",
    "watch": "vite build --mode production --watch",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath githooks 2>/dev/null; npm run build",
    "audit:styles": "node scripts/audit-inline-styles.mjs",
    "audit:scales": "node scripts/scale-audit.mjs",
    "health": "node scripts/health.mjs",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "style-rubric": "node scripts/style-rubric.mjs",
    "render-coverage": "node scripts/render-coverage.mjs",
    "doc-coverage": "node scripts/doc-coverage.mjs",
    "execution-coverage": "node scripts/execution-coverage.mjs",
    "kpi": "node scripts/kpi-table.mjs",
    "report:exports": "node scripts/export-usage-report.mjs",
    "usage-manifest": "node scripts/usage-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:dev": "tsc -p tsconfig.dev.json",
    "lint": "node scripts/lint-ci.mjs lint src",
    "lint:ci": "node scripts/lint-ci.mjs lint src --error-on-warnings",
    "lint:fix": "biome lint --write src",
    "lint:all": "biome lint",
    "format": "biome format",
    "format:write": "biome format --write",
    "check": "node scripts/lint-ci.mjs lint src && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "solidjs",
    "components",
    "ui"
  ],
  "author": "PrimeStage",
  "license": "Commercial",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "d3-scale": "^4.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@solidjs/testing-library": "^0.8.10",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "d3-scale": "^4.0.2",
    "jsdom": "^26.1.0",
    "solid-devtools": "^0.34.5",
    "solid-js": "^1.9.14",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "d3-dag": "^1.2.1",
    "katex": "^0.17.0"
  }
}
