{
  "$comment": "Manifest for scripts/style-rubric.mjs. Maps each src/components *.tsx that legitimately keeps an inline style={{ … }} to the rubric CATEGORIES it is allowed to use. A file's allowed CSS properties are the union of its categories' property lists (see `categories` below and CATEGORY_PROPS in style-rubric.mjs). `cssvar` grants any --* custom property. A file that uses style={{ but is absent here is a violation; so is a property outside its categories, or a pure static-literal value. Keep this in sync when adding/removing inline styles — do NOT widen a file's categories to launder a real violation; move static values to CSS or a curried variant instead.",
  "categories": {
    "measured": ["width", "height", "min-width", "min-height", "max-width", "max-height", "top", "left", "transform"],
    "plotted": ["grid-row", "grid-column", "top", "left", "transform", "transition"],
    "proportion": ["width", "height", "flex", "flex-basis", "transform", "clip-path", "transition"],
    "paint": ["background", "background-color", "color", "border-color", "opacity", "transition"],
    "anchored": ["top", "left", "right", "bottom", "transform"],
    "columnar": ["width", "max-width", "min-width", "text-align"],
    "cssvar": ["(any --* custom property)"]
  },
